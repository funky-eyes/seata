{
  "name": "console-fe",
  "version": "2.0.0",
  "description": "Apache Seata console frontend",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apache/incubator-seata.git"
  },
  "engines": {
    "node": "24.11.1",
    "npm": "11.6.2"
  },
  "scripts": {
    "ci:install": "npm ci",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build && node scripts/copy-saga-designer.mjs",
    "audit:security": "npm audit --audit-level=low",
    "audit:licenses": "node scripts/check-frontend-licenses.mjs --all",
    "test:e2e": "playwright test",
    "scan:html-injection": "node scripts/scan-html-injection.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.29.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "3.11.0",
    "typescript": "^5.9.3",
    "vite": "6.4.2"
  }
}
